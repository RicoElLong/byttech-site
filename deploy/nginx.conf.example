# Inside an HTTPS server block with the confirmed domain and valid TLS certificate.
# Use HTTP->HTTPS redirection in a separate port-80 server block.
root /srv/byttech-release/site;
autoindex off;
location / { try_files $uri $uri/ =404; }
location = /api/requests { proxy_pass http://127.0.0.1:8001; }
location = /api/requests/config { proxy_pass http://127.0.0.1:8001; }
location = /api/analytics/event {
    client_max_body_size 2k;
    proxy_pass http://127.0.0.1:8002;
}
location = /api/analytics/report {
    auth_basic "BytTech admin";
    auth_basic_user_file /etc/nginx/byttech-admin.htpasswd;
    proxy_set_header Authorization "";
    proxy_pass http://127.0.0.1:8002;
}
location /api/ { return 404; }
location = /admin { return 308 /admin/; }
location = /admin/ { rewrite ^ /admin/index.html last; }
location ~ ^/admin/(index\.html|analytics\.(html|js)|editor\.js|preview\.js|style\.css|defaults\.json|schema\.json)$ {
    auth_basic "BytTech admin";
    auth_basic_user_file /etc/nginx/byttech-admin.htpasswd;
    try_files $uri =404;
}
location /admin/ {
    auth_basic "BytTech admin";
    auth_basic_user_file /etc/nginx/byttech-admin.htpasswd;
    proxy_pass http://127.0.0.1:8001;
}
# No database, .env files, backend code, or backups inside the web root.
