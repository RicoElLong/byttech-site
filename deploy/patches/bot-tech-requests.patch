diff --git a/tests/test_requests_compat.py b/tests/test_requests_compat.py
new file mode 100644
index 0000000..3993b0a
--- /dev/null
+++ b/tests/test_requests_compat.py
@@ -0,0 +1,49 @@
+from dataclasses import replace
+import os
+import unittest
+from unittest.mock import patch
+from fastapi.testclient import TestClient
+import test_web_api as base
+from web_api import create_app
+
+
+class RequestsCompatibilityTests(unittest.TestCase):
+    setUp = base.WebApiTests.setUp
+    tearDown = base.WebApiTests.tearDown
+
+    def submit(self, **changes):
+        body=dict(self.body, personal_data_consent=True, consent_version='pd-2026-11-09-v1')
+        body.update(changes)
+        return self.client.post('/api/requests', json=body, headers=self.headers)
+
+    @patch.dict(os.environ, {'WEB_DOCUMENTS_CONFIRMED':'1'})
+    def test_accept_retry_and_consent_persisted(self):
+        self.assertTrue(self.client.get('/api/requests/config').json()['ready'])
+        first=self.submit(); self.assertEqual(first.status_code,200)
+        number=first.json()['request_id'];self.assertIs(type(number),int)
+        self.assertEqual(self.submit().json()['request_id'],number)
+        store=self.app.state.store
+        with store.connect() as db:
+            row=db.execute('SELECT * FROM website_leads').fetchone()
+            self.assertEqual(row['consent_version'],'pd-2026-11-09-v1')
+            self.assertTrue(row['consent_at'])
+            self.assertEqual(db.execute('SELECT COUNT(*) FROM website_leads').fetchone()[0],1)
+        self.assertEqual(len(store.pending()),1)
+        self.assertEqual(self.submit(name='Изменено').status_code,422)
+
+    @patch.dict(os.environ, {'WEB_DOCUMENTS_CONFIRMED':'0'})
+    def test_disabled_does_not_store(self):
+        self.assertFalse(self.client.get('/api/requests/config').json()['ready'])
+        self.assertEqual(self.submit().status_code,503)
+        self.assertEqual(self.app.state.store.pending(),[])
+
+    @patch.dict(os.environ, {'WEB_DOCUMENTS_CONFIRMED':'1'})
+    def test_reject_missing_consent_and_unknown_choices(self):
+        for change in ({'personal_data_consent':False},{'consent_version':'old'},{'phone':'123'},{'problem':'unknown'}):
+            self.assertEqual(self.submit(**change).status_code,422)
+
+    @patch.dict(os.environ, {'WEB_DOCUMENTS_CONFIRMED':'1'})
+    def test_missing_operator_disables_compatibility(self):
+        with TestClient(create_app(replace(self.settings,operator_name=''),notifications=False)) as client:
+            self.assertFalse(client.get('/api/requests/config').json()['ready'])
+            self.assertEqual(client.post('/api/requests',json=self.body,headers=self.headers).status_code,503)
